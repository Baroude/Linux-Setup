/**
 * Matugen dynamic color scheme for Rofi
 * Generated by scripts/wallpaper-next.sh — do not edit manually.
 **/

* {
    /* M3 semantic roles */
    background:            {{ colors.background.dark.hex }};
    background-alt:        {{ colors.surface.dark.hex }};
    foreground:            {{ colors.on_background.dark.hex }};
    foreground-muted:      {{ colors.on_surface_variant.dark.hex }};

    accent:                {{ colors.primary.dark.hex }};
    on-accent:             {{ colors.on_primary.dark.hex }};
    secondary:             {{ colors.secondary.dark.hex }};
    tertiary:              {{ colors.tertiary.dark.hex }};

    surface:               {{ colors.surface.dark.hex }};
    surface-variant:       {{ colors.surface_variant.dark.hex }};
    outline:               {{ colors.outline.dark.hex }};
    error:                 {{ colors.error.dark.hex }};

    /* Rofi semantic aliases */
    selected:              {{ colors.primary.dark.hex }};
    selected-fg:           {{ colors.on_primary.dark.hex }};
    active:                {{ colors.tertiary.dark.hex }};
    urgent:                {{ colors.error.dark.hex }};
}
