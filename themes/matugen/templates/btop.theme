# Generated by matugen — do not edit manually.
# Re-generated by scripts/wallpaper-next.sh on each wallpaper rotation.
# Activated via: color_theme = "matugen" in btop.conf

theme[main_bg]="{{ colors.background.dark.hex }}"
theme[main_fg]="{{ colors.on_background.dark.hex }}"
theme[title]="{{ colors.on_surface.dark.hex }}"
theme[hi_fg]="{{ colors.primary.dark.hex }}"
theme[selected_bg]="{{ colors.surface_variant.dark.hex }}"
theme[selected_fg]="{{ colors.on_surface.dark.hex }}"
theme[inactive_fg]="{{ colors.on_surface_variant.dark.hex }}"
theme[proc_misc]="{{ colors.on_surface_variant.dark.hex }}"
theme[div_line]="{{ colors.outline_variant.dark.hex }}"

# Box borders
theme[cpu_box]="{{ colors.primary.dark.hex }}"
theme[mem_box]="{{ colors.secondary.dark.hex }}"
theme[net_box]="{{ colors.tertiary.dark.hex }}"
theme[proc_box]="{{ colors.tertiary_container.dark.hex }}"

# Temperature gradient: cool → hot
theme[temp_start]="{{ colors.tertiary.dark.hex }}"
theme[temp_end]="{{ colors.error.dark.hex }}"

# CPU usage gradient
theme[cpu_start]="{{ colors.primary.dark.hex }}"
theme[cpu_end]="{{ colors.error.dark.hex }}"
theme[cpu_color1]="{{ colors.primary.dark.hex }}"
theme[cpu_color2]="{{ colors.secondary.dark.hex }}"
theme[cpu_color3]="{{ colors.error.dark.hex }}"
theme[cpu_color4]="{{ colors.error_container.dark.hex }}"

# Graph colors (sparklines)
theme[graph_color1]="{{ colors.tertiary.dark.hex }}"
theme[graph_color2]="{{ colors.secondary.dark.hex }}"
theme[graph_color3]="{{ colors.primary.dark.hex }}"
theme[graph_color4]="{{ colors.primary_container.dark.hex }}"
theme[graph_color5]="{{ colors.error.dark.hex }}"
theme[graph_color6]="{{ colors.secondary_container.dark.hex }}"
theme[graph_color7]="{{ colors.tertiary_container.dark.hex }}"
theme[graph_color8]="{{ colors.on_primary_container.dark.hex }}"
theme[graph_color9]="{{ colors.on_secondary_container.dark.hex }}"
theme[graph_color10]="{{ colors.on_tertiary_container.dark.hex }}"
