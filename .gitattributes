# Force LF line endings for all shell scripts and text files
# This prevents Windows git from converting to CRLF, which breaks bash shebangs
* text=auto eol=lf

# Explicitly mark shell scripts as LF
*.sh text eol=lf

# JSON and other text files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.py text eol=lf

# Binary files - no line ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
